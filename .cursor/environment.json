{
  "name": "Parivahan Panel Sync",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "chmod +x scripts/cloud-agent-install.sh scripts/cloud-agent-start.sh && ./scripts/cloud-agent-install.sh",
  "start": "./scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "api-server",
      "command": "export PORT=5000 SESSION_SECRET=${SESSION_SECRET:-dev-session-secret} DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/parivahan} && pnpm --filter @workspace/api-server run dev"
    },
    {
      "name": "web-panel",
      "command": "export PORT=5173 VITE_API_URL=${VITE_API_URL:-http://localhost:5000} && pnpm --filter @workspace/web-panel run dev"
    }
  ],
  "ports": [
    { "name": "api-server", "port": 5000 },
    { "name": "web-panel", "port": 5173 }
  ]
}

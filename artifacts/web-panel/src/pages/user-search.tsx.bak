import { useState } from 'react';
import { Layout } from '@/components/layout';
import { useToast } from '@/hooks/use-toast';
import {
  Search, Loader2, Database, FileText, Copy, CheckCircle2,
  ExternalLink, Shield, AlertTriangle
} from 'lucide-react';

const API_URL = 'https://leakosintapi.com/';
const API_TOKEN = '8273405443:5dEY9SC';

export function UserSearch() {
  const { toast } = useToast();
  const [query, setQuery] = useState('');
  const [limit, setLimit] = useState(100);
  const [lang, setLang] = useState('en');
  const [loading, setLoading] = useState(false);
  const [results, setResults] = useState<any>(null);
  const [error, setError] = useState('');
  const [copied, setCopied] = useState(false);
  const [expandedDb, setExpandedDb] = useState<string | null>(null);
  const [currentPage, setCurrentPage] = useState(0);

  const handleSearch = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!query.trim()) {
      toast({ title: 'Error', description: 'Please enter a search query', variant: 'destructive' });
      return;
    }

    setLoading(true);
    setError('');
    setResults(null);
    setCurrentPage(0);

    try {
      const data = {
        token: API_TOKEN,
        request: query.trim(),
        limit: limit,
        lang: lang,
        type: 'json',
        bot_name: '@LeakosintBot',
      };

      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!res.ok) {
        const errText = await res.text();
        throw new Error(errText || `HTTP ${res.status}`);
      }

      const json = await res.json();
      if (json['Error code']) {
        throw new Error(json['Error code']);
      }
      setResults(json);
    } catch (err: any) {
      setError(err.message || 'Search failed');
      toast({ title: 'Error', description: 'Search failed. Check your query.', variant: 'destructive' });
    } finally {
      setLoading(false);
    }
  };

  const copyAll = async () => {
    if (!results) return;
    try {
      const lines: string[] = [];
      for (const [dbName, dbData] of Object.entries(results.List || {})) {
        const info: any = dbData;
        lines.push(`=== ${dbName} ===`);
        if (info?.InfoLeak) lines.push(info.InfoLeak);
        if (Array.isArray(info?.Data)) {
          for (const row of info.Data) {
            for (const [k, v] of Object.entries(row)) {
              lines.push(`${k}: ${v}`);
            }
            lines.push('');
          }
        }
      }
      await navigator.clipboard.writeText(lines.join('\n'));
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
      toast({ title: '✅ Copied', description: 'All results copied to clipboard' });
    } catch {
      toast({ title: 'Error', description: 'Failed to copy', variant: 'destructive' });
    }
  };

  const dbNames = results?.List ? Object.keys(results.List) : [];
  const pagedDbs = dbNames.slice(currentPage * 5, currentPage * 5 + 5);

  return (
    <Layout>
      <div className="max-w-4xl mx-auto space-y-6">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-[#2d1b4e] flex items-center gap-2">
            <Search className="w-6 h-6 text-[#7c3aed]" />
            Data Search
          </h1>
          <p className="text-[#6b5b7d] text-sm mt-1">
            Search leaked database records (phone, email, name, ID)
          </p>
        </div>

        {/* Search Form */}
        <div className="bg-[#ecdbfd] border border-[#d8c8f0] rounded-3xl overflow-hidden">
          <div className="h-1 w-full bg-[#7c3aed]" />
          <form onSubmit={handleSearch} className="p-5 space-y-4">
            <div>
              <label className="text-[10px] font-bold uppercase tracking-wider text-[#6b5b7d] block mb-1.5">
                Search Query
              </label>
              <textarea
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder='e.g. example@gmail.com or "Elon Reeve Musk" or +919876543210'
                rows={2}
                className="w-full bg-[#f5efff] border border-[#d8c8f0] rounded-2xl px-4 py-3 text-sm text-[#2d1b4e] focus:outline-none focus:border-[#7c3aed] transition-all"
              />
              <p className="text-[10px] text-[#6b5b7d] mt-1">
                Use double quotes for exact phrases. Multiple lines = multiple searches.
              </p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label className="text-[10px] font-bold uppercase tracking-wider text-[#6b5b7d] block mb-1.5">
                  Limit (100-10000)
                </label>
                <input
                  type="number"
                  value={limit}
                  onChange={(e) => setLimit(Math.min(10000, Math.max(100, parseInt(e.target.value) || 100)))}
                  min={100}
                  max={10000}
                  className="w-full bg-[#f5efff] border border-[#d8c8f0] rounded-2xl px-4 py-2.5 text-sm text-[#2d1b4e] focus:outline-none focus:border-[#7c3aed] transition-all"
                />
              </div>
              <div>
                <label className="text-[10px] font-bold uppercase tracking-wider text-[#6b5b7d] block mb-1.5">
                  Language
                </label>
                <select
                  value={lang}
                  onChange={(e) => setLang(e.target.value)}
                  className="w-full bg-[#f5efff] border border-[#d8c8f0] rounded-2xl px-4 py-2.5 text-sm text-[#2d1b4e] focus:outline-none focus:border-[#7c3aed] transition-all"
                >
                  <option value="en">English</option>
                  <option value="ru">Russian</option>
                </select>
              </div>
            </div>

            <button
              type="submit"
              disabled={loading}
              className="w-full bg-[#7c3aed] hover:bg-[#6d28d9] disabled:opacity-50 text-white font-bold py-3 rounded-full transition-all text-sm flex items-center justify-center gap-2 shadow-md shadow-purple-200"
            >
              {loading ? (
                <><Loader2 className="w-4 h-4 animate-spin" /> Searching...</>
              ) : (
                <><Search className="w-4 h-4" /> Search Database</>
              )}
            </button>
          </form>
        </div>

        {error && (
          <div className="bg-red-50 border border-[#ef4444]/30 rounded-3xl p-4 text-sm text-[#ef4444] flex items-start gap-3">
            <AlertTriangle className="w-5 h-5 flex-shrink-0" />
            <div>
              <p className="font-semibold">Search Error</p>
              <p className="text-xs mt-0.5">{error}</p>
            </div>
          </div>
        )}

        {/* Results */}
        {results && (
          <div className="space-y-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2 text-sm font-semibold text-[#2d1b4e]">
                <Database className="w-4 h-4 text-[#7c3aed]" />
                Results: {dbNames.length} databases
              </div>
              <button
                onClick={copyAll}
                className="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-[#f5efff] border border-[#d8c8f0] text-[#7c3aed] hover:bg-[#ecdbfd] transition-colors"
              >
                {copied ? <CheckCircle2 className="w-3.5 h-3.5" /> : <Copy className="w-3.5 h-3.5" />}
                {copied ? 'Copied!' : 'Copy All'}
              </button>
            </div>

            {dbNames.length === 1 && (dbNames[0] === 'No results found') && (
              <div className="bg-[#f5efff] border border-[#d8c8f0] rounded-3xl p-8 text-center">
                <FileText className="w-12 h-12 text-[#9ca3af] mx-auto mb-3" />
                <h3 className="font-semibold text-[#2d1b4e] mb-1">No Results Found</h3>
                <p className="text-sm text-[#6b5b7d]">Try a different query or increase the limit.</p>
              </div>
            )}

            {pagedDbs.map((dbName) => {
              const info: any = results.List[dbName];
              const isExpanded = expandedDb === dbName;
              return (
                <div key={dbName} className="bg-[#ecdbfd] border border-[#d8c8f0] rounded-3xl overflow-hidden">
                  <button
                    onClick={() => setExpandedDb(isExpanded ? null : dbName)}
                    className="w-full flex items-center justify-between p-4 hover:bg-[#f5efff] transition-colors"
                  >
                    <div className="flex items-center gap-3">
                      <div className="w-9 h-9 rounded-xl bg-[#7c3aed]/10 flex items-center justify-center">
                        <Database className="w-4 h-4 text-[#7c3aed]" />
                      </div>
                      <div className="text-left">
                        <h4 className="font-semibold text-[#2d1b4e] text-sm">{dbName}</h4>
                        {info?.InfoLeak && <p className="text-xs text-[#6b5b7d] line-clamp-1">{info.InfoLeak}</p>}
                      </div>
                    </div>
                    <span className="text-xs font-bold text-[#7c3aed] bg-[#ecdbfd] px-2.5 py-1 rounded-full">
                      {Array.isArray(info?.Data) ? info.Data.length : 0} records
                    </span>
                  </button>

                  {isExpanded && (
                    <div className="border-t border-[#d8c8f0] bg-[#faf7ff] p-4 space-y-3">
                      {Array.isArray(info?.Data) && info.Data.length > 0 ? (
                        info.Data.map((row: any, i: number) => (
                          <div key={i} className="bg-white border border-[#d8c8f0] rounded-2xl p-4">
                            {Object.entries(row).map(([k, v]) => (
                              <div key={k} className="flex justify-between items-start gap-4 py-1 border-b border-[#d8c8f0]/50 last:border-0">
                                <span className="text-xs font-medium text-[#6b5b7d] uppercase tracking-wider flex-shrink-0 mt-0.5">{k}</span>
                                <span className="text-sm text-[#2d1b4e] text-right break-all font-mono">{String(v)}</span>
                              </div>
                            ))}
                          </div>
                        ))
                      ) : (
                        <p className="text-sm text-[#6b5b7d] text-center py-3">No detailed records in this database.</p>
                      )}
                    </div>
                  )}
                </div>
              );
            })}

            {dbNames.length > 5 && (
              <div className="flex items-center justify-center gap-2 pt-2">
                <button
                  onClick={() => setCurrentPage((p) => Math.max(0, p - 1))}
                  disabled={currentPage === 0}
                  className="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5efff] border border-[#d8c8f0] text-[#7c3aed] disabled:opacity-40"
                >
                  ← Prev
                </button>
                <span className="text-xs font-semibold text-[#6b5b7d]">
                  Page {currentPage + 1} / {Math.max(1, Math.ceil(dbNames.length / 5))}
                </span>
                <button
                  onClick={() => setCurrentPage((p) => p + 1)}
                  disabled={(currentPage + 1) * 5 >= dbNames.length}
                  className="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5efff] border border-[#d8c8f0] text-[#7c3aed] disabled:opacity-40"
                >
                  Next →
                </button>
              </div>
            )}

            <p className="text-[10px] text-[#6b5b7d] flex items-center gap-1 pt-2">
              <Shield className="w-3 h-3" />
              Powered by Leakosint API — limit: 3 requests/sec per IP. Click a database name to expand records.
            </p>
          </div>
        )}
      </div>
    </Layout>
  );
}